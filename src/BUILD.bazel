load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "objc_library")
load("//third_party/vulkan:glsl.bzl", "glsl_header")

cc_library(
    name = "core",
    hdrs = ["core.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "math",
    hdrs = ["math.h"],
    visibility = ["//visibility:public"],
    deps = [":core"],
)

cc_library(
    name = "j2",
    hdrs = ["j2.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        ":math",
    ],
)

cc_library(
    name = "platform",
    hdrs = ["platform.h"],
    deps = [
        ":core",
        "@vulkan",
    ],
)

objc_library(
    name = "platform_macos",
    srcs = [
        "clock.h",
        "icon.h",
        "platform_macos.mm",
    ],
    copts = [
        "-std=c++20",
        "-fobjc-arc",
    ],
    sdk_frameworks = [
        "AppKit",
        "QuartzCore",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":platform"],
)

cc_library(
    name = "platform_win32",
    hdrs = ["platform_win32.h"],
    visibility = ["//visibility:public"],
)

glsl_header(
    name = "earth_vert",
    src = "earth.vert",
    variable = "kEarthVert",
)

glsl_header(
    name = "earth_frag",
    src = "earth.frag",
    variable = "kEarthFrag",
)

glsl_header(
    name = "sphere_vert",
    src = "sphere.vert",
    variable = "kSphereVert",
)

glsl_header(
    name = "sphere_frag",
    src = "sphere.frag",
    variable = "kSphereFrag",
)

glsl_header(
    name = "text_vert",
    src = "text.vert",
    variable = "kTextVert",
)

glsl_header(
    name = "text_frag",
    src = "text.frag",
    variable = "kTextFrag",
)

glsl_header(
    name = "link_vert",
    src = "link.vert",
    variable = "kLinkVert",
)

glsl_header(
    name = "link_frag",
    src = "link.frag",
    variable = "kLinkFrag",
)

glsl_header(
    name = "satellite_vert",
    src = "satellite.vert",
    variable = "kSatelliteVert",
)

glsl_header(
    name = "satellite_frag",
    src = "satellite.frag",
    variable = "kSatelliteFrag",
)

cc_binary(
    name = "app",
    srcs = [
        "borders.h",
        "clock.h",
        "geodetic.h",
        "icon.h",
        "main.cc",
        "satellites.h",
        "slug.h",
        "stations.h",
        "sun.h",
        "text.h",
        ":earth_frag",
        ":earth_vert",
        ":link_frag",
        ":link_vert",
        ":satellite_frag",
        ":satellite_vert",
        ":sphere_frag",
        ":sphere_vert",
        ":text_frag",
        ":text_vert",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "/DEFAULTLIB:user32.lib",
            "/DEFAULTLIB:gdi32.lib",
        ],
        "@platforms//os:macos": [
            "-framework CoreFoundation",
            "-framework CoreGraphics",
            "-framework CoreText",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":core",
        ":j2",
        ":math",
        ":platform",
        "//src/array",
        "//src/bit",
        "@vulkan",
    ] + select({
        "@platforms//os:macos": [":platform_macos"],
        "@platforms//os:windows": [":platform_win32"],
        "//conditions:default": [],
    }),
)
