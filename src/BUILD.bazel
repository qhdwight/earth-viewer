load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//third_party/vulkan:glsl.bzl", "glsl_header")

cc_library(
    name = "core",
    hdrs = ["core.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "math",
    hdrs = ["math.h"],
    visibility = ["//visibility:public"],
    deps = [":core"],
)

glsl_header(
    name = "earth_vert",
    src = "earth.vert",
    variable = "kEarthVert",
)

glsl_header(
    name = "earth_frag",
    src = "earth.frag",
    variable = "kEarthFrag",
)

cc_binary(
    name = "app",
    srcs = [
        "borders.h",
        "main.cc",
        ":earth_frag",
        ":earth_vert",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "/DEFAULTLIB:user32.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":core",
        ":math",
        "//src/array",
        "//src/bit",
        "@vulkan",
    ],
)
